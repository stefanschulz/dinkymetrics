{
    "name": "theloom/mod-dinkymetrics",
    "description": "Development tooling for the DinkyMetrics Joomla site module. The module itself has no runtime dependencies.",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Stefan Schulz",
            "email": "schulz@the-loom.de",
            "homepage": "https://www.the-loom.de"
        }
    ],
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload-dev": {
        "psr-4": {
            "TheLoom\\Module\\DinkyMetrics\\Site\\": "src/",
            "TheLoom\\Module\\DinkyMetrics\\Tests\\": "tests/Unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "test": "phpunit"
    }
}
